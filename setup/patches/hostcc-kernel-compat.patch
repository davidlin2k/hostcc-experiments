diff --git a/src/hostcc-local-response.c b/src/hostcc-local-response.c
index e5cf861..0050a4a 100644
--- a/src/hostcc-local-response.c
+++ b/src/hostcc-local-response.c
@@ -51,12 +51,18 @@ void init_mba_process_scheduler(void){
     }
     else{
       printk(KERN_INFO "Found task");
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 9, 0)
+      /* sched_setscheduler() is not exported to modules since 5.9;
+       * sched_set_fifo() uses SCHED_FIFO priority 50 instead of 99. */
+      sched_set_fifo(app_pid_task);
+#else
       struct sched_param param;
       param.sched_priority = 99;
       int result = sched_setscheduler(app_pid_task, SCHED_FIFO, &param);
       if (result == -1) {
           printk(KERN_ALERT "Failed to set scheduling policy and priority\n");
       }
+#endif
     }
 }
 
